# Reflex .env — copy to .env and fill in. Keep values in single quotes: Bug Watcher `source`s this file.

# Slack (api.slack.com/apps > Reflex)
SLACK_BOT_TOKEN='xoxb-...'                      # OAuth & Permissions > Bot User OAuth Token
SLACK_APP_TOKEN='xapp-...'                      # Basic Information > App-Level Tokens (connections:write)
QA_CHANNEL_ID='C..., C...'                      # Version Check watches these channels (comma-separated)
PRODUCT_GROUP_BY_CHANNEL='C...:S...,C...:S...'  # Version Check tags this user group per channel; unmapped → message author

# Claude engine for app.py (Max subscription, no API key)
CLAUDE_CODE_OAUTH_TOKEN='sk-ant-oat-...'        # CLAUDE_CONFIG_DIR=~/.claude-reflex claude setup-token
CLAUDE_BIN='claude'                             # claude CLI executable
VERSION_CHECK_MODEL='haiku'
VERSION_CHECK_EFFORT='low'                      # low | medium | high | xhigh | max
VERSION_CHECK_TIMEOUT='60'                      # seconds
BUG_DETAILS_MODEL='opus'
BUG_DETAILS_EFFORT='medium'
BUG_DETAILS_TIMEOUT='180'                       # seconds

# Task Move
ASANA_PAT='...'                                 # Asana personal access token (app.asana.com/0/my-apps)

# Stats (ThinkingData)
TE_MCP_URL='https://...'                        # ThinkingData MCP HTTP endpoint the Stats queries are posted to
TE_MCP_TOKEN='...'                              # its mcp-token (shared "Gizem" account)
STATS_URL='http://productmacmini.local:3800'    # address the Slack "Stats" shortcut hands out
STATS_PORT='3800'

# Ops dashboard and logs (Mac mini)
OPS_PORT='3900'
REFLEX_LOG_DIR='~/Library/Logs/Reflex'          # logs, job records, routine run files (Ops/ops.py reads them)
