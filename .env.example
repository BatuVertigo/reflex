# Slack Bot Token (Slack app > OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-...

# Slack App-Level Token (Slack app > Basic Information > App-Level Tokens)
SLACK_APP_TOKEN=xapp-...

# Version Check only acts in these channels. Use comma to separate multiple channels.
QA_CHANNEL_ID='...'

# Version Check tags these groups per channel: <channel ID>:<user group ID>, comma-separated for more.
PRODUCT_GROUP_BY_CHANNEL=C0636S9C278:S09ADDKDVND

# --- Claude Code (motor) ---
# No need for an API key; the it uses your Claude Max subscription (`claude setup-token` to generate a token)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...
CLAUDE_BIN=claude

# --- Version Check --
VERSION_CHECK_MODEL=haiku
VERSION_CHECK_TIMEOUT=60
VERSION_CHECK_EFFORT=low # low | medium | high | xhigh | max

# --- Bug Details ---
BUG_DETAILS_MODEL=opus
BUG_DETAILS_TIMEOUT=180
BUG_DETAILS_EFFORT=medium

# --- Task Move ---
# Asana Personal Access Token (app.asana.com/0/my-apps)
ASANA_PAT=...

# --- Stats Polygun ---
# TE (ThinkingData) MCP endpoint and token
TE_MCP_URL=
TE_MCP_TOKEN=
# 3800 if null
STATS_PORT=
# Fixed address of the Stats page, shown by the Slack "Stats" shortcut (the live IP is added as a fallback line).
STATS_URL=http://productmacmini.local:3800

# --- Mac mini (launchd) ---
# Logs, job records and routine run files; Ops/ops.py reads them. Default: ~/Library/Logs/Reflex
REFLEX_LOG_DIR=
# Ops dashboard port, 3900 if null
OPS_PORT=
