# Slack Bot Token (Slack app > OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-...

# Slack App-Level Token (Slack app > Basic Information > App-Level Tokens)
SLACK_APP_TOKEN=xapp-...

# The bot only acts in these channels. Use comma to separate multiple channels.
QA_CHANNEL_ID='...'

# --- Claude Code (motor) ---
# No need for an API key; the it uses your Claude Max subscription (`claude setup-token` to generate a token)
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat...
CLAUDE_BIN=claude

# --- Version Check --
VERSION_CHECK_MODEL=haiku
VERSION_CHECK_TIMEOUT=60
VERSION_CHECK_EFFORT=low # low | medium | high | xhigh | max

# --- Bug Details ---
BUG_DETAILS_MODEL=opus
BUG_DETAILS_TIMEOUT=180
BUG_DETAILS_EFFORT=medium

# --- Task Move ---
# Asana Personal Access Token (app.asana.com/0/my-apps)
ASANA_PAT=...
